/target
/*/target/
/AppDir
/build
/dist
/appimagetool-*.AppImage
/*.AppImage

# Subcrate build dirs (workspace members have their own target/ dirs).
/bakeneko-core/target/
/bakeneko-ui/target/

# Lib crates don't commit Cargo.lock (keep single source of truth at workspace root).
/bakeneko-core/Cargo.lock
/bakeneko-ui/Cargo.lock

# Graphify (knowledge graph - generated, not committed)
/graphify-out/
.graphify*

# Java Daemon Gradle build outputs
/daemon/build/
/daemon/.gradle/
