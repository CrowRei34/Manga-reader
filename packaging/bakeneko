#!/bin/sh
set -eu
SELF=$(readlink -f "$0")
HERE=${SELF%/*}
export JAVA_HOME="$HERE/app/jre"
export BAKENEKO_HOME="$HERE/app"
export BAKENEKO_SOLVER_PATH="$HERE/app/bakeneko-solver"
if [ ! -x "$BAKENEKO_HOME/jre/bin/java" ]; then
  echo "ERROR: falta Java incluido en $BAKENEKO_HOME/jre/bin/java" >&2
  exit 1
fi
if [ ! -f "$BAKENEKO_HOME/bakeneko-daemon.jar" ]; then
  echo "ERROR: falta el núcleo Java en $BAKENEKO_HOME/bakeneko-daemon.jar" >&2
  exit 1
fi
if [ ! -x "$BAKENEKO_SOLVER_PATH" ]; then
  echo "ERROR: falta el solver en $BAKENEKO_SOLVER_PATH" >&2
  exit 1
fi

# WebKitGTK es el motor WebView nativo de Wry en Linux. No se puede incluir de
# forma fiable dentro de un tar genérico porque integra procesos y recursos del
# sistema; avisamos con precisión si falta, sin impedir el uso de otras fuentes.
if command -v ldd >/dev/null 2>&1; then
  MISSING_SOLVER_LIBS=$(ldd "$BAKENEKO_SOLVER_PATH" 2>/dev/null | awk '/not found/ { print $1 }' | tr '\n' ' ')
  if [ -n "$MISSING_SOLVER_LIBS" ]; then
    echo "AVISO: el solver no podrá iniciarse; faltan bibliotecas: $MISSING_SOLVER_LIBS" >&2
    echo "Instala WebKitGTK 4.1 (Void: libwebkit2gtk41; Debian/Ubuntu: libwebkit2gtk-4.1-0)." >&2
  fi
fi
exec "$HERE/app/bakeneko" "$@"
